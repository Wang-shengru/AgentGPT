# ===== TWTX V9 台指期盤面終端（唯讀・無策略・無部位）=====
# 模式：mock = 模擬行情（未設定金鑰時預設）；live = 永豐 Shioaji 真實行情
TWTX_MODE=mock

# Shioaji 憑證（只存在後端 .env，絕不送到前端）。唯讀終端「不需要」CA 憑證。
SJ_API_KEY=
SJ_SECRET_KEY=
# true = Shioaji 模擬環境（開發期）
SJ_SIMULATION=false

# 服務埠（狀態膠囊 8001 / 8006 / 8010 對應下列三項）
API_PORT=8001        # 主服務：WebSocket /ws、REST /api、前端靜態檔
ENGINE_PORT=8006     # 資料引擎健康檢查
STORE_PORT=8010      # 落地 tick 存取服務（health / 查詢）
BIND_HOST=127.0.0.1

# 落地資料夾（每交易日一個 SQLite 檔）
DATA_DIR=./data

# 開盤集合競價第一筆是否扣除（Delta / 主動買比）
EXCLUDE_OPENING_AUCTION=true
# 前端可回顧的交易日數
KEEP_DAYS=10
# 5 分量比：同時段過去 N 日平均
VOLUME_RATIO_DAYS=5
# 休市日（YYYY-MM-DD，逗號分隔），用於交易日歸屬
HOLIDAYS=
# 現貨成交金額單位換算：指數 amount_sum 除以此值得到「億」
SPOT_AMOUNT_DIVISOR=100000000

# Mock 模式：時間倍速（1 = 真實速度），休市時以最近一個交易時段的虛擬時鐘播放
MOCK_SPEED=1
MOCK_HISTORY_DAYS=25
MOCK_SEED=9

# 計分參數檔（JSON，可覆寫 scoring.DEFAULT_PARAMS 任一鍵）
SCORING_PARAMS_FILE=
